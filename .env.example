# -----------------------------------------------------------------------------
# Django
# -----------------------------------------------------------------------------
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://admin:password@localhost:5432/survera_db

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Email (console backend is used in local.py by default)
# -----------------------------------------------------------------------------
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Inbox used for local/manual email tests (notifications, invites, verification codes)
EMAIL_FOR_TEST=surveracorp.test@gmail.com
# When True, all outbound mail is redirected to EMAIL_FOR_TEST (handy in local)
# EMAIL_REDIRECT_TO_TEST=True

# -----------------------------------------------------------------------------
# Production only
# -----------------------------------------------------------------------------
# SECURE_SSL_REDIRECT=True

# Public URL for email links (no trailing slash)
SITE_URL=http://localhost:8000
